# Editor defaults, so formatting does not depend on each person's editor setup.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,js,json,jsonc,yml,yaml,svg}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; stripping them changes
# the rendered output.
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
